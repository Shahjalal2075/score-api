# Your Highlightly (or RapidAPI) key. Get one at https://highlightly.net/login
HIGHLIGHTLY_API_KEY="your-api-key-here"

# Leave as-is when using a Highlightly key directly.
# For a RapidAPI key instead, use:
#   HIGHLIGHTLY_BASE_URL="https://cricket-highlights-api.p.rapidapi.com"
#   HIGHLIGHTLY_HOST="cricket-highlights-api.p.rapidapi.com"
HIGHLIGHTLY_BASE_URL="https://cricket.highlightly.net"
HIGHLIGHTLY_HOST=""

# Free plan allowance. Only used for the "requests left today" display —
# the real limit is enforced by Highlightly.
DAILY_REQUEST_LIMIT=100

# Matches are listed in this timezone.
TIMEZONE="Asia/Dhaka"

PORT=5100

# ---- Fantasy service bridge ----
# The fantasy backend this panel can push scorecards to. A completely
# separate application with its own database — these two settings are the
# only connection between them. Leave blank to disable the bridge.
FANTASY_API_URL="https://your-fantasy-server.onrender.com"
# Must match LIVE_SYNC_KEY in the fantasy backend's own .env.
LIVE_SYNC_KEY=""

# ---- Hosting ----
# Where the JSON store lives. On Render this must point at the mounted
# disk, or every restart loses the cache, the pairings and the request
# counter. Leave unset locally.
DATA_DIR=""

# Comma-separated origins allowed to call this server. Set to your
# Netlify URL in production; leave blank locally to allow anything.
CORS_ORIGIN=""
